{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "checkJs": true,
    "strict": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.svelte"]
}

[Unit]
Description=OVCP — OpenVPN control plane (owns PKI, config and the openvpn worker)
After=network-online.target
Wants=network-online.target

[Service]
# systemd drops privileges itself: ovcp never starts as root, and it and its
# openvpn/dnsmasq/nft children hold only these two capabilities.
ExecStart=/usr/bin/ovcp serve
Environment=OVCP_DATA=/var/lib/ovcp
User=ovcp
Group=ovcp
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# created owned by ovcp; overriding OVCP_DATA needs a matching StateDirectory=.
StateDirectory=ovcp
StateDirectoryMode=0700
RuntimeDirectory=ovcp
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=2
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

#!/sbin/openrc-run
# Started as root, ovcp drops to its own account; supervise-daemon respawns it.

name="ovcp"
description="OVCP — OpenVPN control plane"
command="/usr/bin/ovcp"
command_args="serve"
supervisor="supervise-daemon"

depend() {
	# soft, like the unit's Wants=: start even if networking never comes up
	use net dns
}
